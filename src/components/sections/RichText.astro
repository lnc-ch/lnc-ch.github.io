---
import { getLocalizedCopy, type Locale } from "../../lib/i18n";

interface LocalCopy {
  heading?: string;
  body: string;
}

interface Props {
  locale: Locale;
  variant?: "standard" | "statement";
  copy: {
    ja: LocalCopy;
    fr?: Partial<LocalCopy>;
    en?: Partial<LocalCopy>;
  };
}

const { locale, variant = "standard", copy } = Astro.props;
const text = getLocalizedCopy(copy, locale);
---

<section
  class:list={["section", "rich-text", `rich-text--${variant}`]}
  data-locale={locale}
>
  <div class="rich-text__copy" data-animate>
    {text.heading && <h2>{text.heading}</h2>}
    <div class="prose" set:html={text.body} />
  </div>
</section>
