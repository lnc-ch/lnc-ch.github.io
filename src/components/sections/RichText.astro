---
interface Props {
  heading?: string;
  body: string;
}

const { heading, body } = Astro.props;
---

<section class="section prose-section">
  {heading && <h2>{heading}</h2>}
  <div class="prose" set:html={body} />
</section>

<style>
  .prose-section {
    display: grid;
    gap: 1.5rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: -.035em;
  }

  .prose {
    max-width: 52rem;
    font-size: 1.08rem;
    line-height: 1.65;
  }
</style>
