---
import { getLocalizedCopy, type Locale } from "../../lib/i18n";

interface LocalItemCopy {
  alt?: string;
  caption?: string;
}

interface Item {
  image: string;
  copy: {
    ja: LocalItemCopy;
    fr?: Partial<LocalItemCopy>;
    en?: Partial<LocalItemCopy>;
  };
}

interface Props {
  locale: Locale;
  copy: {
    ja: { heading?: string };
    fr?: { heading?: string };
    en?: { heading?: string };
  };
  items: Item[];
}

const { locale, copy, items } = Astro.props;
const text = getLocalizedCopy(copy, locale);
---

<section class="section gallery" data-locale={locale}>
  {text.heading && <h2 data-animate>{text.heading}</h2>}

  <div class="gallery__grid">
    {
      items.map((item) => {
        const itemText = getLocalizedCopy(item.copy, locale);

        return (
          <figure data-animate>
            <img src={item.image} alt={itemText.alt ?? ""} loading="lazy" />
            {itemText.caption && <figcaption>{itemText.caption}</figcaption>}
          </figure>
        );
      })
    }
  </div>
</section>
