---
import { getLocalizedCopy, localizeHref, type Locale } from "../../lib/i18n";

interface LocalCopy {
  heading: string;
  body?: string;
  label: string;
}

interface Props {
  locale: Locale;
  href: string;
  copy: {
    ja: LocalCopy;
    fr?: Partial<LocalCopy>;
    en?: Partial<LocalCopy>;
  };
}

const { locale, href, copy } = Astro.props;
const text = getLocalizedCopy(copy, locale);
---

<section class="section cta" data-locale={locale}>
  <div data-animate>
    <h2>{text.heading}</h2>
    {text.body && <p>{text.body}</p>}
  </div>

  <a class="button" href={localizeHref(href, locale)} data-animate>
    {text.label}
  </a>
</section>
