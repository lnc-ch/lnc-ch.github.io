---
interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  image?: string;
  layout?: "left" | "center";
}

const { eyebrow, heading, subheading, image, layout = "left" } = Astro.props;
---

<section
  class:list={["section", "hero", `hero--${layout}`]}
  data-hero
>
  {image && (
    <div class="hero__media" data-scroll data-scroll-speed="-0.08">
      <img class="hero__image" src={image} alt="" />
    </div>
  )}

  <div class="hero__orbit" data-scroll data-scroll-speed="0.12" aria-hidden="true">
    <span>46°31′N</span>
    <span>06°38′E</span>
  </div>

  <div class="hero__ghost" data-scroll data-scroll-speed="-0.16" aria-hidden="true">
    日本
  </div>

  <div class="hero__content">
    {eyebrow && <p class="eyebrow" data-hero-reveal>{eyebrow}</p>}
    <h1 data-split-words>{heading}</h1>
    {subheading && <p class="hero__subheading" data-hero-reveal>{subheading}</p>}
  </div>

  <div class="hero__footer" data-hero-reveal>
    <span>Scroll to explore</span>
    <span class="hero__line"></span>
    <span>01 — ∞</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    align-items: end;
    position: relative;
    overflow: clip;
    padding-top: 9rem;
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .hero::before {
    content: "";
    position: absolute;
    width: min(52vw, 44rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    right: -10vw;
    top: 8vh;
    z-index: -2;
    filter: saturate(.9);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 15, 14, .1), rgba(15, 15, 14, .72)),
      linear-gradient(90deg, rgba(15, 15, 14, .36), transparent 60%);
  }

  .hero__image {
    width: 100%;
    height: 115%;
    object-fit: cover;
    filter: grayscale(.15) contrast(1.06);
  }

  .hero:has(.hero__image) {
    color: var(--paper);
  }

  .hero:has(.hero__image)::before {
    opacity: .45;
    mix-blend-mode: multiply;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero--center .hero__content {
    text-align: center;
  }

  h1 {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(5rem, 14vw, 13rem);
    font-weight: 600;
    line-height: .76;
    letter-spacing: -.075em;
    text-transform: uppercase;
  }

  .hero--center h1 {
    margin-inline: auto;
  }

  :global(.hero h1 .word) {
    display: inline-block;
    overflow: hidden;
    padding-right: .09em;
    margin-right: -.09em;
  }

  :global(.hero h1 .word__inner) {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: .7rem;
    font-weight: 650;
  }

  .hero__subheading {
    width: min(35rem, 80vw);
    margin: clamp(1.5rem, 4vw, 3rem) 0 0 auto;
    font-size: clamp(1.05rem, 1.8vw, 1.55rem);
    line-height: 1.25;
    letter-spacing: -.02em;
  }

  .hero--center .hero__subheading {
    margin-inline: auto;
  }

  .hero__ghost {
    position: absolute;
    top: 13vh;
    right: 3vw;
    font-size: clamp(8rem, 26vw, 25rem);
    line-height: .8;
    font-weight: 700;
    opacity: .08;
    writing-mode: vertical-rl;
    z-index: -1;
    user-select: none;
  }

  .hero__orbit {
    position: absolute;
    top: 9rem;
    left: 0;
    display: flex;
    gap: 1rem;
    font-size: .65rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero__footer {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(4rem, 8vw, 8rem);
    text-transform: uppercase;
    font-size: .65rem;
    letter-spacing: .12em;
  }

  .hero__line {
    height: 1px;
    background: currentColor;
    opacity: .45;
    transform-origin: left;
  }

  @media (max-width: 700px) {
    .hero {
      padding-top: 8rem;
    }

    h1 {
      font-size: clamp(4.3rem, 21vw, 8rem);
    }

    .hero__subheading {
      margin-left: 0;
    }

    .hero__orbit {
      display: none;
    }
  }
</style>
