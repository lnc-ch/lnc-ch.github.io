---
import { getLocalizedCopy, type Locale } from "../../lib/i18n";

interface LocalCopy {
  eyebrow?: string;
  heading: string;
  subheading?: string;
}

interface Props {
  locale: Locale;
  layout?: "default" | "center";
  image?: string;
  copy: {
    ja: LocalCopy;
    fr?: Partial<LocalCopy>;
    en?: Partial<LocalCopy>;
  };
}

const { locale, layout = "default", image, copy } = Astro.props;
const text = getLocalizedCopy(copy, locale);
---

<section
  class:list={["section", "hero", `hero--${layout}`]}
  data-locale={locale}
>
  {image && <img class="hero__image" src={image} alt="" />}

  <div class="hero__copy" data-animate>
    {text.eyebrow && <p class="eyebrow">{text.eyebrow}</p>}
    <h1>{text.heading}</h1>
    {text.subheading && <p>{text.subheading}</p>}
  </div>
</section>
