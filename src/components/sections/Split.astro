---
interface Props {
  heading: string;
  body: string;
  image: string;
  imageAlt?: string;
  imagePosition?: "left" | "right";
}

const { heading, body, image, imageAlt = "", imagePosition = "right" } = Astro.props;
---

<section class:list={["section", "split", `split--${imagePosition}`]}>
  <div class="split__copy">
    <h2>{heading}</h2>
    <div class="prose" set:html={body} />
  </div>
  <img src={image} alt={imageAlt} />
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
  }

  .split--left img {
    order: -1;
  }

  h2 {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    letter-spacing: -.035em;
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }

    .split--left img {
      order: 0;
    }
  }
</style>
