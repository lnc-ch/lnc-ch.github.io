---
interface Props {
  heading: string;
  body: string;
  image: string;
  imageAlt?: string;
  imagePosition?: "left" | "right";
}

const { heading, body, image, imageAlt = "", imagePosition = "right" } = Astro.props;
---

<section class:list={["section", "split", `split--${imagePosition}`]} data-section>
  <div class="split__copy">
    <p class="split__label">Perspective / 視点</p>
    <h2 data-reveal>{heading}</h2>
    <div class="prose" data-reveal set:html={body} />
  </div>

  <div class="split__media" data-reveal>
    <div data-scroll data-scroll-speed="0.08">
      <img src={image} alt={imageAlt} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
    border-top: 1px solid var(--line);
  }

  .split--left .split__media {
    order: -1;
  }

  .split__label {
    margin: 0 0 3rem;
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .13em;
  }

  h2 {
    margin: 0 0 2rem;
    max-width: 9ch;
    font-size: clamp(3rem, 6vw, 7rem);
    line-height: .9;
    font-weight: 520;
    letter-spacing: -.055em;
  }

  .prose {
    max-width: 34rem;
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .split__media {
    overflow: hidden;
  }

  .split__media > div {
    height: 110%;
    margin-block: -5%;
  }

  img {
    width: 100%;
    min-height: 38rem;
    height: 75svh;
    object-fit: cover;
    filter: saturate(.78) contrast(1.06);
    transition: filter .6s ease, transform 1.1s var(--ease-out);
  }

  .split__media:hover img {
    filter: saturate(1) contrast(1);
    transform: scale(1.025);
  }

  @media (max-width: 800px) {
    .split {
      grid-template-columns: 1fr;
    }

    .split--left .split__media {
      order: 0;
    }

    img {
      min-height: 0;
      height: 60svh;
    }
  }
</style>
