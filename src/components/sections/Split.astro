---
import { getLocalizedCopy, type Locale } from "../../lib/i18n";

interface LocalCopy {
  heading: string;
  body: string;
  imageAlt?: string;
}

interface Props {
  locale: Locale;
  image: string;
  imagePosition?: "left" | "right";
  copy: {
    ja: LocalCopy;
    fr?: Partial<LocalCopy>;
    en?: Partial<LocalCopy>;
  };
}

const { locale, image, imagePosition = "right", copy } = Astro.props;
const text = getLocalizedCopy(copy, locale);
---

<section
  class:list={["section", "split", `split--${imagePosition}`]}
  data-locale={locale}
>
  <div class="split__copy" data-animate>
    <h2>{text.heading}</h2>
    <div class="prose" set:html={text.body} />
  </div>

  <img src={image} alt={text.imageAlt ?? ""} loading="lazy" data-animate />
</section>
