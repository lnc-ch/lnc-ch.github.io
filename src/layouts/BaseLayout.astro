---
import site from "../data/site.json";
import { localeLabels, localizePath, type Locale } from "../lib/i18n";

import "normalize.css/normalize.css";
import "locomotive-scroll/dist/locomotive-scroll.css";
import "../styles/global.css";
import "../styles/transitions.css";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  slug: string;
}

const { title, description = site.description, locale, slug } = Astro.props;
const pageTitle = `${title} — ${site.name}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>

  <body data-barba="wrapper">
    <div
      class="page-shell"
      data-barba="container"
      data-barba-namespace={locale}
      data-locale={locale}
    >
      <header class="site-header">
        <a class="site-name" href={localizePath("/", locale)}>{site.name}</a>

        <nav class="site-nav" aria-label="Main navigation">
          {
            site.navigation.map((item) => (
              <a href={localizePath(item.href, locale)}>{item.label[locale]}</a>
            ))
          }
        </nav>

        <nav class="language-nav" aria-label="Language">
          {
            (Object.keys(localeLabels) as Locale[]).map((targetLocale) => (
              <a
                href={localizePath(slug, targetLocale)}
                aria-current={targetLocale === locale ? "page" : undefined}
              >
                {localeLabels[targetLocale]}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>{site.name}</span>
      </footer>
    </div>

    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
