---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-ext-400.css';
import '@fontsource/zen-old-mincho/400.css';
import '@fontsource-variable/hanken-grotesk';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import '../styles/fonts.css';
import { pageMeta, renderHead, renderDocumentBody } from '../lib/render/page.mjs';

// Content is schema-validated by Astro. The same escaped render functions are
// used by the dependency-free regression tests and the static visual fixture.
const { model } = Astro.props;
const meta = pageMeta(model);
---
<!doctype html>
<html lang={meta.lang} style={`background:${meta.background};color:${meta.foreground}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Fragment set:html={String(renderHead(model))} />
  </head>
  <body data-barba="wrapper">
    <Fragment set:html={String(renderDocumentBody(model))} />
    <div id="transition-layer" aria-hidden="true"></div>
    <div id="page-announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/app.mjs';
    </script>
  </body>
</html>
