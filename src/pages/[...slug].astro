---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeEntries } from '../lib/content.mjs';
import site from '../data/site.json';
import fixture from '../../tests/fixtures/design.json';

export async function getStaticPaths() {
  const preview = process.env.LNC_PREVIEW === '1';
  const testing = process.env.LNC_TEST_FIXTURES === '1';
  if (testing && !preview) throw new Error('Test fixtures require LNC_PREVIEW=1.');
  // Always validate genuine CMS collections, including during browser tests.
  const cmsPages = (await getCollection('pages')).map((entry) => entry.data);
  const cmsEvents = (await getCollection('events')).map((entry) => entry.data);
  const pages = testing ? fixture.pages : cmsPages;
  const events = testing ? fixture.events : cmsEvents;
  const now = testing ? new Date('2026-10-05T12:00:00Z') : new Date();
  return routeEntries(pages, events, preview).map((route) => ({
    params: { slug: route.param },
    props: { model: { ...route, site, pages, events, preview, now } },
  }));
}
const { model } = Astro.props;
---
<BaseLayout model={model} />
